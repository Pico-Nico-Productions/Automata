{
	"schemaVersion": 1,
	"id": "automata",
	"version": "${version}",
	"name": "Automata",
	"description": "Simple automated bots.",
	"authors": [
		"Nick S Will"
	],
	"contact": {
		"homepage": "https://github.com/Pico-Nico-Productions/Automata",
		"sources": "https://github.com/Pico-Nico-Productions/Automata"
	},
	"license": "CC0-1.0",
	"icon": "assets/automata/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"pro.piconico.automata.Automata"
		],
		"client": [
			"pro.piconico.automata.client.AutomataClient"
		],
		"fabric-datagen": [
			"pro.piconico.automata.datagen.AutomataDataGenerator"
		]
	},
	"accessWidener": "automata.classtweaker",
	"mixins": [
		"automata.mixins.json",
		{
			"config": "automata.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}